MONGODB_URI=
JWT_SECRET=
PORT=5000
NODE_ENV=development
REQUEST_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Stripe Test API Secret Key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
FRONTEND_BASE_URL=http://localhost:3000

# GoHighLevel webhooks: employee account created (by admin) / promoter event created
GHL_EMPLOYEE_ACCOUNT_WEBHOOK_URL=
GHL_PROMOTER_EVENT_CREATED_WEBHOOK_URL=
# ── GHL outbound webhooks (all optional; built-in production URLs are used when blank)
LEAD_CONNECTOR_WEBHOOK_URL=
GHL_ZELLE_CONFIRMED_WEBHOOK_URL=
GHL_PROMOTER_APPLICATION_NOTIFICATION_WEBHOOK_URL=
GHL_PROMOTER_VERIFICATION_WEBHOOK_URL=
# ── GHL client tuning
GHL_WEBHOOKS_ENABLED=true
GHL_WEBHOOK_TIMEOUT_MS=10000
GHL_WEBHOOK_MAX_ATTEMPTS=3
GHL_WEBHOOK_BACKOFF_MS=500
GHL_LOG_PAYLOADS=false

# ── Google Calendar sync (venue bookings + Tropica promoter events)
# Service-account JSON key, base64-encoded (or GOOGLE_SERVICE_ACCOUNT_JSON with raw JSON)
GOOGLE_SERVICE_ACCOUNT_B64=
# Calendar shared with the service account's client_email ("Make changes to events")
GOOGLE_CALENDAR_ID=

# Tropica AI booking assistant
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
AI_WEBHOOK_SECRET=
GHL_API_TOKEN=
AI_EXTRA_FACTS=
AI_REPLY_MODE=webhook
GHL_AI_REPLY_WEBHOOK_URL=
AI_DM_BOOKING_ENABLED=false
AI_PUBLIC_SITE_URL=https://www.tropica.nyc
GHL_AI_HANDOFF_WEBHOOK_URL=
